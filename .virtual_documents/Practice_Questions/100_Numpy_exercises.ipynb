








%run initialise.py





import numpy as np





print(np.__version__)       #version of numpy
np.show_config()            #it identifies your speed engines(for troubleshooting)





vec = np.zeros(10)  #create an array of size 10 filled with 0
print(vec)





print(vec.size)                 #gives size of array(number of elements)
print(vec.itemsize)             #gives size of individual elements(datatype)
print(vec.size*vec.itemsize)    #gives size of complete array in bytes
print(vec.nbytes)               #gives size of complete array in bytes











vec = np.zeros(10)
vec[4]=1        #normal indexing
print(vec)





vec = np.arange(10,50)  #arange function ranges from 10 to 49 
print(vec)





vec = vec[::-1]     #slicing
print(vec)





vec = np.arange(9).reshape(3,3) #first created a 1d array then reshaped it to 3x3
print(vec)





vec = np.array([1,2,0,0,4,0])   
ind = np.nonzero(vec)   #gives array of indices of non-zero elements
print(ind)
print(type(ind))





mat = np.eye(3)         #creates an identity matrix given an order
mat = np.identity(3,dtype=int)    #same
print(mat)





#matrix with random float numbers between 0 and 1
mat = np.random.random((3,3,3))     
print(mat)

#matrix with random integers between 1 and 100
mat = np.random.randint(1,101,(3,3,3)) 
print(mat)





mat = np.random.random((10,10))
print(mat)

#min value + its index
print(mat.min(),mat.argmin())
print(mat.max(),mat.argmax())





vec = np.random.random(30)
print (vec.mean())  #mean of all elements





mat = np.ones((5,5))
mat[1:-1,1:-1] = 0  #slicing inside portion
#   row  column
print(mat) 





mat2 = np.zeros((7,7))
mat2[1:-1 , 1:-1] = mat
print(mat2)

Z = np.pad(mat, pad_width=1, mode='constant', constant_values=0)
print(Z)











# mat = np.zeros((5,5))

# mat = np.diag(np.array([1,4,9]),k=2)
mat = np.diag(np.arange(1,5),k=-1)      #ranges from 0 to 4 on diagonal=-1
print(mat)





mat = np.zeros((8,8))
mat[::2,::2] = 1
mat[1::2,1::2] = 1
print(mat)





x,y,z = np.indices((6,7,8)) #6 7x8 matrices
ind = np.argwhere(x*56 + y*8 +z + 1 == 100)
print(ind)




#method 2

coords = np.unravel_index(99,(6,7,8))   #gives index of 100th element   
print(coords)       #numpy int64
print(type(coords[0]))  
print(tuple(int(c) for c in coords))    #converts them to python int
print(type(int(coords[0]))) 


#method 3
#opposite way --> to get nth element from coordinates

flat_idx = np.ravel_multi_index((1,5,3),(6,7,8))
print(flat_idx)





arr1 = np.array([[1,0],[0,1]])
print(np.tile(arr1,(4,4)))


























































































































































































































































































































































































































































































